{
  "name": "recipes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup-auth.mjs && prisma generate && node scripts/setup-database.mjs && prisma migrate deploy",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "tsc -p tsconfig.tests.json && node --test .test-output/tests/*.test.js",
    "pretest:e2e": "prisma generate",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "biome check",
    "format": "biome format --write",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@next/env": "^16.4.0",
    "@prisma/client": "^6.19.2",
    "better-auth": "^1.7.7",
    "next": "16.1.3",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
